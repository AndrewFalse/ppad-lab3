# Только для локального учебного запуска.
# Перед первым запуском выполните bash make_env.sh: он создаст .env и заполнит пустые пароли и ключи случайными значениями.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Пароли ролей, которые создаёт sql/init/01_init.sh
AIRFLOW_DB_PASSWORD=
METABASE_DB_PASSWORD=
DWH_ETL_PASSWORD=
DWH_BI_PASSWORD=

# Airflow
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
